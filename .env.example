# ============================================================
# OASIS configuration
#
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.
# ============================================================

# --- LLM: candidate generation -------------------------------
# Google Gemini API key. Everything except candidate generation
# works without it; the pipeline stops after energy smell detection.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_SECONDS=120
# GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Energy measurement --------------------------------------
# Optional: CodeCarbon accepts a free Electricity Maps API key to
# resolve region-aware carbon intensity.
# CODECARBON_API_KEY=
